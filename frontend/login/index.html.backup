<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>NEXORA | Iniciar sesión</title>

    <meta
        name="description"
        content="NEXORA - Inteligencia contable y tributaria"
    >

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
        }

        body {
            font-family:
                Inter,
                ui-sans-serif,
                system-ui,
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                sans-serif;

            background:
                radial-gradient(
                    circle at 15% 20%,
                    rgba(91, 74, 255, 0.35),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 85% 80%,
                    rgba(0, 190, 255, 0.25),
                    transparent 32%
                ),
                linear-gradient(
                    135deg,
                    #071126 0%,
                    #10183d 45%,
                    #171342 100%
                );

            color: #ffffff;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px;
            overflow-x: hidden;
        }

        /* Elementos decorativos */

        .background-orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(2px);
            pointer-events: none;
            z-index: 0;
        }

        .orb-one {
            width: 260px;
            height: 260px;
            background: rgba(83, 68, 255, 0.14);
            top: -80px;
            left: -70px;
        }

        .orb-two {
            width: 320px;
            height: 320px;
            background: rgba(0, 204, 255, 0.10);
            right: -120px;
            bottom: -130px;
        }

        .page {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 1080px;
            min-height: 650px;

            display: grid;
            grid-template-columns: 1fr 430px;

            border: 1px solid rgba(255, 255, 255, 0.10);
            border-radius: 28px;

            background: rgba(10, 18, 45, 0.72);

            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);

            box-shadow:
                0 30px 80px rgba(0, 0, 0, 0.35),
                inset 0 1px 0 rgba(255, 255, 255, 0.05);

            overflow: hidden;
        }

        /* Panel izquierdo */

        .presentation {
            padding: 70px;
            display: flex;
            flex-direction: column;
            justify-content: center;

            background:
                linear-gradient(
                    145deg,
                    rgba(33, 48, 110, 0.35),
                    rgba(11, 20, 50, 0.10)
                );
        }

        .brand {
            font-size: 30px;
            font-weight: 800;
            letter-spacing: 2px;
            margin-bottom: 65px;
        }

        .brand span {
            font-size: 12px;
            vertical-align: top;
            opacity: 0.65;
        }

        .presentation h1 {
            margin: 0 0 22px;
            font-size: clamp(40px, 5vw, 62px);
            line-height: 1.05;
            letter-spacing: -2px;
        }

        .gradient-text {
            background:
                linear-gradient(
                    90deg,
                    #ffffff,
                    #aebcff,
                    #75ddff
                );

            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .presentation p {
            max-width: 530px;
            color: #b8c3df;
            font-size: 17px;
            line-height: 1.75;
            margin: 0;
        }

        .features {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 35px;
        }

        .feature {
            padding: 9px 13px;
            border-radius: 20px;

            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.08);

            color: #c9d3ee;
            font-size: 13px;
        }

        /* Panel login */

        .login-area {
            background: rgba(255, 255, 255, 0.97);
            color: #17213d;

            padding: 55px 48px;

            display: flex;
            align-items: center;
        }

        .login-content {
            width: 100%;
        }

        .login-heading {
            margin-bottom: 32px;
        }

        .login-heading h2 {
            margin: 0 0 9px;
            font-size: 29px;
            color: #111b38;
        }

        .login-heading p {
            margin: 0;
            color: #737d91;
            font-size: 14px;
            line-height: 1.5;
        }

        .form-group {
            margin-bottom: 19px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            font-weight: 700;
            color: #26314d;
        }

        .input-wrapper {
            position: relative;
        }

        input {
            width: 100%;
            height: 49px;

            padding: 0 14px;

            border: 1px solid #d9deea;
            border-radius: 10px;

            background: #f9fafc;

            color: #18223d;
            font-size: 15px;

            outline: none;

            transition:
                border-color 0.2s,
                box-shadow 0.2s,
                background 0.2s;
        }

        input::placeholder {
            color: #a0a8b8;
        }

        input:focus {
            background: #ffffff;
            border-color: #5b63e9;

            box-shadow:
                0 0 0 4px rgba(91, 99, 233, 0.12);
        }

        .password-input {
            padding-right: 48px;
        }

        .toggle-password {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);

            border: none;
            background: transparent;

            color: #6e7890;
            cursor: pointer;

            font-size: 13px;
            font-weight: 700;
        }

        .toggle-password:hover {
            color: #4d57c9;
        }

        .login-button {
            width: 100%;
            height: 50px;

            margin-top: 7px;

            border: none;
            border-radius: 10px;

            background:
                linear-gradient(
                    100deg,
                    #4f46e5,
                    #6d55ed,
                    #268ee6
                );

            color: #ffffff;

            font-size: 15px;
            font-weight: 700;

            cursor: pointer;

            box-shadow:
                0 10px 25px rgba(79, 70, 229, 0.24);

            transition:
                transform 0.2s,
                box-shadow 0.2s;
        }

        .login-button:hover {
            transform: translateY(-1px);

            box-shadow:
                0 14px 30px rgba(79, 70, 229, 0.30);
        }

        .login-button:active {
            transform: translateY(0);
        }

        #mensaje {
            min-height: 22px;
            margin-top: 18px;

            text-align: center;

            font-size: 14px;
            font-weight: 600;
        }

        .security-note {
            margin-top: 30px;
            padding-top: 18px;

            border-top: 1px solid #e8ebf2;

            text-align: center;

            color: #8992a4;
            font-size: 12px;
            line-height: 1.5;
        }

        .back-link {
            display: block;
            margin-top: 17px;

            text-align: center;

            color: #5b63c9;
            text-decoration: none;

            font-size: 13px;
            font-weight: 600;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        /* Responsive */

        @media (max-width: 850px) {

            body {
                padding: 18px;
            }

            .page {
                grid-template-columns: 1fr;
                max-width: 500px;
            }

            .presentation {
                padding: 45px 35px;
                min-height: 320px;
            }

            .brand {
                margin-bottom: 40px;
            }

            .presentation h1 {
                font-size: 43px;
            }

            .login-area {
                padding: 42px 35px;
            }
        }

        @media (max-width: 480px) {

            body {
                padding: 10px;
            }

            .page {
                border-radius: 20px;
            }

            .presentation {
                padding: 35px 25px;
            }

            .login-area {
                padding: 35px 25px;
            }

            .presentation h1 {
                font-size: 38px;
            }

            .presentation p {
                font-size: 15px;
            }

            .features {
                margin-top: 25px;
            }
        }
    </style>
</head>

<body>

    <div class="background-orb orb-one"></div>
    <div class="background-orb orb-two"></div>

    <main class="page">

        <!-- PRESENTACIÓN -->

        <section class="presentation">

            <div class="brand">
                NEXORA<span>®</span>
            </div>

            <h1>
                <span class="gradient-text">
                    Inteligencia
                </span>
                <br>
                contable y tributaria.
            </h1>

            <p>
                Gestiona la información de tus empresas desde una
                plataforma diseñada para integrar procesos contables,
                tributarios y herramientas inteligentes en un solo lugar.
            </p>

            <div class="features">

                <div class="feature">
                    SIRE
                </div>

                <div class="feature">
                    SSCO
                </div>

                <div class="feature">
                    Comprobantes
                </div>

                <div class="feature">
                    Análisis tributario
                </div>

            </div>

        </section>


        <!-- LOGIN -->

        <section class="login-area">

            <div class="login-content">

                <div class="login-heading">

                    <h2>
                        Bienvenido
                    </h2>

                    <p>
                        Ingresa a tu cuenta para continuar.
                    </p>

                </div>


                <form id="loginForm">

                    <div class="form-group">

                        <label for="usuario">
                            Usuario
                        </label>

                        <input
                            type="text"
                            id="usuario"
                            placeholder="Ingresa tu usuario"
                            autocomplete="username"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label for="password">
                            Contraseña
                        </label>

                        <div class="input-wrapper">

                            <input
                                type="password"
                                id="password"
                                class="password-input"
                                placeholder="Ingresa tu contraseña"
                                autocomplete="current-password"
                                required
                            >

                            <button
                                type="button"
                                class="toggle-password"
                                id="togglePassword"
                            >
                                Mostrar
                            </button>

                        </div>

                    </div>


                    <button
                        type="submit"
                        class="login-button"
                    >
                        Ingresar a NEXORA
                    </button>

                </form>


                <div id="mensaje"></div>


                <div class="security-note">
                    Acceso protegido por el sistema NEXORA.
                </div>


                <a
                    href="/"
                    class="back-link"
                >
                    ← Volver a NEXORA
                </a>

            </div>

        </section>

    </main>


    <script>

        // Mostrar / ocultar contraseña

        document
            .getElementById("togglePassword")
            .addEventListener("click", function () {

                const password =
                    document.getElementById("password");

                if (password.type === "password") {

                    password.type = "text";

                    this.textContent = "Ocultar";

                } else {

                    password.type = "password";

                    this.textContent = "Mostrar";
                }

            });


        // Login

        document
            .getElementById("loginForm")
            .addEventListener("submit", async function(event) {

                event.preventDefault();

                const usuario =
                    document.getElementById("usuario").value;

                const password =
                    document.getElementById("password").value;

                const mensaje =
                    document.getElementById("mensaje");


                mensaje.textContent = "Verificando acceso...";
                mensaje.style.color = "#5f6b82";


                try {

                    const respuesta = await fetch(
                        "/api/login",
                        {
                            method: "POST",

                            headers: {
                                "Content-Type": "application/json"
                            },

                            body: JSON.stringify({
                                usuario: usuario,
                                password: password
                            })
                        }
                    );


                    const resultado =
                        await respuesta.json();


                    mensaje.textContent =
                        resultado.mensaje;


                    if (resultado.success) {

                        mensaje.style.color = "#16845a";

                        setTimeout(function() {

                            window.location.href = "/menu/";

                        }, 400);

                    } else {

                        mensaje.style.color = "#d23b4a";

                    }


                } catch (error) {

                    mensaje.textContent =
                        "No se pudo conectar con el servidor.";

                    mensaje.style.color = "#d23b4a";

                }

            });

    </script>

</body>
</html>
